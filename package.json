{
  "name": "secrets-worker",
  "version": "4.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy src/index.ts",
    "build": "wrangler deploy --dry-run --outdir dist src/index.ts",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "bash scripts/smoke.sh",
    "test:kv": "bash scripts/kv-invariants.sh",
    "test:d1": "bash scripts/d1-invariants.sh",
    "test:csp": "bash scripts/csp-check.sh",
    "test": "npm run lint && npm run test:unit && npm run test:smoke && npm run test:kv && npm run test:d1 && npm run test:csp"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@playwright/test": "^1.62.1",
    "@vitest/runner": "^4.1.10",
    "@vitest/snapshot": "^4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
