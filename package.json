{
  "name": "secrets-worker",
  "version": "4.1.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy src/index.ts",
    "build": "wrangler deploy --dry-run --outdir dist src/index.ts",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "bash scripts/smoke.sh",
    "test:kv": "bash scripts/kv-invariants.sh",
    "test:d1": "bash scripts/d1-invariants.sh",
    "test:csp": "bash scripts/csp-check.sh",
    "test": "npm run lint && npm run test:unit && npm run test:smoke && npm run test:kv && npm run test:d1 && npm run test:csp"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.16",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "^4.158.0",
    "@cloudflare/vitest-plugin": "^1.6.0"
  }
}
